# Copy to .env on your PC (or .env.local) and set the same values in Vercel → Settings → Environment Variables.

APP_NAME="Nation Desk"
APP_URL=http://localhost:3000          # online: https://your-app.vercel.app
APP_TIMEZONE=Africa/Nairobi

# Secret for the reminder cron URL (at least 16 characters).
CRON_SECRET=

# Database: MongoDB (e.g. a free MongoDB Atlas cluster). Required, on your PC and online.
# Put the database name after the host, before the "?" — here it is "nation-desk".
# Use a database only this app uses: `npm run db:push` creates collections and indexes in it.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nation-desk?retryWrites=true&w=majority"

# Your email account (SMTP). For Gmail use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# The Laravel-style names work too: MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD,
# MAIL_FROM_NAME, MAIL_FROM_ADDRESS.

# Where uploaded and signed PDFs are stored (optional). Default: <your home folder>/.nation-desk/documents
# DOCS_DIR=
