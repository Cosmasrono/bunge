// Nation Desk data model (MongoDB via Prisma).
// No migrations: apply changes with `npm run db:push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// admin: everything, including Settings. director: manages people and permissions, schedules for others, sends documents.
/// staff: their own schedule, and signing; can also schedule for others / send documents when a director or admin allows it.
enum Role {
  admin
  director
  staff
}

enum DocumentStatus {
  pending
  signed
  declined
  cancelled
}

enum SignerStatus {
  pending
  signed
  declined
}

enum Repeat {
  none
  daily
  weekdays
  weekly
  monthly
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique // always stored lower-case
  name         String
  role         Role      @default(staff)
  passwordHash String
  timezone     String    @default("Africa/Nairobi")
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  /// Extra permissions for staff, granted by a director or admin (admins and directors always have them).
  canSchedule      Boolean?
  canSendDocuments Boolean?

  sessions       Session[]
  passwordResets PasswordReset[]
  events         Event[]
  auditLogs      AuditLog[]
  sentDocuments  Document[] @relation("DocumentSender")
  signDocuments  Document[] @relation("DocumentSigner")
  signerRows     DocumentSigner[]
  pushSubscriptions PushSubscription[]
  notices        Notice[]

  @@map("users")
}

/// Server-side sessions. The cookie holds a random token; we store only its SHA-256 (hex) as the id.
model Session {
  id         String   @id @map("_id")
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  /// "reset" (forgot password) or "invite" (an admin created the account).
  purpose   String    @default("reset")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

/// A sign-up waiting for its emailed 6-digit code. Only hashes of the code and password are stored.
model PendingSignup {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String
  name         String
  passwordHash String
  role         Role     @default(staff)
  codeHash     String
  attempts     Int      @default(0)
  sends        Int      @default(1)
  lastSentAt   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
  @@map("pending_signups")
}

model RateLimit {
  id  String   @id @default(auto()) @map("_id") @db.ObjectId
  key String
  at  DateTime @default(now())

  @@index([key, at])
  @@map("rate_limits")
}

model AuditLog {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  userId String?  @db.ObjectId
  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action String
  detail String   @default("")
  ip     String?
  at     DateTime @default(now())

  @@index([userId, at])
  @@map("audit_log")
}

model Event {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Who added the event: the owner, or an admin adding it to someone else's schedule.
  createdById    String?  @db.ObjectId
  /// Set when one event was added to several people's schedules at once ("Everyone"): all the copies share it,
  /// so they can be changed or deleted together.
  batchId        String?
  title          String
  location       String   @default("")
  notes          String   @default("")
  /// Wall-clock start in the event's time zone, "YYYY-MM-DDTHH:mm".
  startLocal     String
  timezone       String
  /// First occurrence as an exact instant (for sorting and filtering).
  startUtc       DateTime
  repeat         Repeat   @default(none)
  /// Minutes before the event to remind, e.g. [1440, 300, 60, 15]. 0 = at start time.
  leads          Int[]    @default([1440, 300, 60, 15])
  emailReminders Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  remindersSent ReminderSent[]

  @@index([userId])
  @@index([startUtc])
  @@index([batchId])
  @@map("events")
}

/// One document per reminder sent, so nothing is ever sent twice (the unique index is the claim).
model ReminderSent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId    String   @db.ObjectId
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrence DateTime
  lead       Int
  sentAt     DateTime @default(now())

  @@unique([eventId, occurrence, lead])
  @@index([occurrence])
  @@map("reminders_sent")
}

/// Small key/value store for app status (e.g. last reminder run).
model AppState {
  key       String   @id @map("_id")
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_state")
}

/// A PDF sent to one or more people to sign. The file itself lives in file storage (see src/lib/storage.ts);
/// only its details are kept here. Who signs, and how each person signed, is in DocumentSigner.
model Document {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  note          String         @default("")
  fileName      String
  fileSize      Int
  fileKey       String
  /// SHA-256 (hex) of the original PDF, as uploaded.
  fileHash      String
  pageCount     Int
  senderId      String         @db.ObjectId
  sender        User           @relation("DocumentSender", fields: [senderId], references: [id], onDelete: Cascade)
  /// pending until everyone signed (then signed); declined as soon as one signer declines.
  status        DocumentStatus @default(pending)
  createdAt     DateTime       @default(now())
  /// When the last signer signed, someone declined, or the sender cancelled.
  respondedAt   DateTime?
  /// Signing deadline, if the sender put it on the signers' schedules.
  dueAt         DateTime?
  /// The signed PDF (all signatures plus one certificate page per signer), made when the last person signs.
  signedFileKey String?
  /// SHA-256 (hex) of the signed PDF.
  signedHash    String?

  signers       DocumentSigner[]

  // ---- Older, single-signer documents only. Moved into DocumentSigner automatically (src/lib/documents.ts).
  signatureBox   Json?
  signerId       String?        @db.ObjectId
  signer         User?          @relation("DocumentSigner", fields: [signerId], references: [id], onDelete: Cascade)
  declineReason  String         @default("")
  signatureKind  String?
  signerIp       String?
  signerAgent    String?
  signerEvidence Json?
  signerPlace    Json?

  @@index([signerId, status])
  @@index([senderId, createdAt])
  @@map("documents")
}

/// One person who has to sign a document, and how they signed.
model DocumentSigner {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  documentId    String       @db.ObjectId
  document      Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId        String       @db.ObjectId
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Order shown on the document and certificate pages (0 = first).
  position      Int          @default(0)
  status        SignerStatus @default(pending)
  /// Where this person's signature is stamped (see src/lib/signature-box.ts). Empty = certificate page only.
  signatureBox  Json?
  respondedAt   DateTime?
  declineReason String       @default("")
  /// "drawn" or "typed".
  signatureKind String?
  /// The signature itself, kept so the final PDF can carry every signer's: PNG as base64, or the typed name.
  signatureData String?
  ip            String?
  agent         String?
  /// What the signer's device reported (see src/lib/evidence.ts): location, device info, device id.
  evidence      Json?
  /// Street address for the GPS point and the IP's city/country (see src/lib/geo.ts).
  place         Json?
  /// The "sign by" event put on this person's schedule, removed once they answer.
  eventId       String?      @db.ObjectId
  createdAt     DateTime     @default(now())

  @@unique([documentId, userId])
  @@index([userId, status])
  @@map("document_signers")
}

/// An in-app notification (shown as a pop-up while the app is open). Phone/computer pop-ups go through Web Push too.
model Notice {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @default("")
  /// Page in this app to open, e.g. /documents/abc.
  url       String    @default("/")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notices")
}

/// A browser or phone that agreed to get push notifications (Web Push).
model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

/// Uploaded and signed PDFs. Kept in the database so the app also works on hosting without a permanent disk
/// (such as Vercel). Each file is at most about 10 MB, under MongoDB's 16 MB per-record limit.
model StoredFile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@map("stored_files")
}
